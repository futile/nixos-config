+def _deep_merge_dict(base: dict[str, Any], override: Mapping[str, Any]) -> dict[str, Any]:
+    result = deepcopy(base)
+    for key, value in override.items():
+        if isinstance(value, Mapping) and isinstance(result.get(key), dict):
+            result[key] = _deep_merge_dict(result[key], value)
+        else:
+            result[key] = deepcopy(value)
+    return result
+
+
+class RustAnalyzerInitializeParamsBuilder(DefaultInitializeParamsBuilder):
+    @override
+    def _apply_updates(self) -> None:
+        base_initialization_options = deepcopy(self._params["initializationOptions"])
+        initialization_options_override = self._ls.custom_settings.get("initializationOptions", {})
+        if not isinstance(initialization_options_override, Mapping):
+            raise ValueError("ls_specific_settings.rust.initializationOptions must be a mapping")
+
+        super()._apply_updates()
+        if initialization_options_override:
+            self._params["initializationOptions"] = _deep_merge_dict(
+                base_initialization_options, initialization_options_override
+            )
+
+
