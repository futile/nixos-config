{
  "settings": {
    "mcpFooterStatus": "compact"
  },
  "mcpServers": {
    "DeepWiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "lifecycle": "lazy"
    },
    "serena": {
      "command": "/home/felix/nixos/bin/serena-mcp-with-desktop-env",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=codex"
      ],
      "lifecycle": "lazy"
    },
    "blender": {
      "command": "mcp-for-blender",
      "lifecycle": "lazy"
    },
    "gridcraft": {
      "command": "gridcraft-cli",
      "args": ["mcp"],
      "lifecycle": "lazy"
    },
    "gridcraft-app": {
      "command": "gridcraft-cli",
      "args": ["mcp", "--connect", "7979"],
      "lifecycle": "lazy"
    },
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp",
      "env": {
        "CBM_CACHE_DIR": "/home/felix/.cache/codebase-memory-mcp"
      },
      "lifecycle": "lazy"
    }
  }
}
