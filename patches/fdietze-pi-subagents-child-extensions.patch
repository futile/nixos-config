+	/**
+	 * Close all child runtimes without emitting semantic kill events. The caller deliberately
+	 * leaves roster.json untouched so a later process can restore the persisted sessions.
+	 */
+	async shutdownAll(): Promise<string[]> {
+		const closed: string[] = [];
+		for (const [name, rec] of [...this.agents.entries()]) {
+			if (name === "main") continue;
+			this.agents.delete(name);
+			await this.closeRecord(rec);
+			closed.push(name);
+		}
+		// A replacement main session starts with a fresh turn budget and must not inherit an
+		// old session's halted gate. Persistent agents are restored (halted) explicitly.
+		this.frozen = false;
+		this.frozenReason = undefined;
+		this.turnsUsed = 0;
+		return closed;
+	}
+
