+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { readFileSync } from "node:fs";
+import { stripTypeScriptTypes } from "node:module";
+import type { EngineResumeResult } from "./control-result.ts";
+import type { AgentRecord } from "./agent-record.ts";
+import { createRoutedAgentMessage } from "./agent-message.ts";
+import { Engine } from "./engine.ts";
+import { createRestartBridge, RESTART_BRIDGE_KEY } from "./restart-bridge.ts";
+import { createSpawner, type SessionLike } from "./spawner.ts";
+
+function deferred() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((done) => { resolve = done; });
+	return { promise, resolve };
+}
+function record(name: string): AgentRecord {
+	return { name, sessionId: `${name}-id`, model: "test/model", spawnedBy: "main", depth: name === "main" ? 0 : 1,
+		createdAt: 0, turns: 0, lastActivity: 0, handle: { deliver: async () => {}, abort: async () => {} } };
+}
+function fixture() {
+	const engine = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	engine.addAgent(record("main"));
+	return { engine, bridge: createRestartBridge(engine) };
+}
+
+class Session implements SessionLike {
+	sessionId = "child-id";
+	thinkingLevel = "high" as const;
+	messages: unknown[] = [];
+	listeners = new Set<(event: { type: string }) => void>();
+	shutdownGate?: Promise<void>;
+	disposed = false;
+	sendAgentMessage(): void | Promise<void> {}
+	sendUserMessage() {}
+	abort() {}
+	abortBash() {}
+	shutdown() { return this.shutdownGate; }
+	dispose() { this.disposed = true; }
+	async setModel() {}
+	setThinkingLevel() {}
+	subscribe(listener: (event: { type: string }) => void) { this.listeners.add(listener); return () => { this.listeners.delete(listener); }; }
+	emit(type: string) { for (const listener of this.listeners) listener({ type }); }
+	getToolDefinition() { return undefined; }
+	getContextUsage() { return undefined; }
+}
+
+function spawner(engine: Engine, create: () => Promise<{ session: Session }>) {
+	return createSpawner({ engine, resolveModel: () => ({ provider: "test", id: "model", model: {} }), createSession: create });
+}
+
+test("restart bridge is fail-closed for unknown/child identities and permits main's own tool turn", () => {
+	const { engine, bridge } = fixture();
+	assert.equal(RESTART_BRIDGE_KEY, Symbol.for("futile.pi.subagents.restart-in-dir.v1"));
+	engine.addAgent(record("child"));
+	assert.deepEqual(bridge.inspect("main-id"), { main: true, ready: true });
+	for (const id of ["child-id", "unknown", ""]) {
+		assert.equal(bridge.inspect(id).main, false);
+		assert.equal(bridge.acquire(id, "token").ok, false);
+	}
+	engine.setActivity("main", "tool", "restart_in_dir");
+	assert.equal(bridge.inspect("main-id").ready, true);
+});
+
+test("queued actor delivery to main is busy until acceptance, not until main settles", () => {
+	const { engine, bridge } = fixture();
+	engine.beginTurn("main");
+	engine.queueMainDelivery("delivery");
+	assert.equal(bridge.inspect("main-id").ready, false);
+	engine.acceptMainDelivery("unrelated");
+	assert.equal(bridge.inspect("main-id").ready, false);
+	engine.acceptMainDelivery("delivery");
+	assert.equal(bridge.inspect("main-id").ready, true);
+});
+
+test("reservations, buffered messages, paused inboxes and compaction refuse, idle paused records allow", async () => {
+	const { engine, bridge } = fixture();
+	assert.equal(engine.reserve("pending", "main").ok, true);
+	assert.equal(bridge.acquire("main-id", "token").ok, false);
+	engine.release("pending");
+	const child = record("child");
+	child.paused = true;
+	engine.addAgent(child);
+	assert.equal(bridge.inspect("main-id").ready, true);
+	await engine.route("main", "child", "queued");
+	assert.equal(bridge.inspect("main-id").ready, false);
+	child.pausedInbox = undefined;
+	child.buffer = [createRoutedAgentMessage("main", "pending")];
+	assert.equal(bridge.inspect("main-id").ready, false);
+	child.buffer = undefined;
+	child.compacting = true;
+	assert.equal(bridge.inspect("main-id").ready, false);
+	child.compacting = false;
+	assert.equal(bridge.inspect("main-id").ready, true);
+});
+
+test("lease is same-token idempotent, blocks admission, and wrong-token release cannot unlock", async () => {
+	const { engine, bridge } = fixture();
+	const child = record("child"); child.paused = true; engine.addAgent(child);
+	assert.equal(bridge.acquire("main-id", "lease").ok, true);
+	assert.equal(bridge.acquire("main-id", "lease").ok, true);
+	assert.equal(bridge.inspect("main-id").ready, true);
+	assert.equal(bridge.acquire("main-id", "other").ok, false);
+	assert.equal(engine.reserve("new", "main").ok, false);
+	assert.equal((await engine.route("main", "child", "no")).outcome, "failed");
+	assert.equal(engine.deliverUser("child", "no").outcome, "refused");
+	assert.equal((await engine.resume("main")).results[0]?.ok, false);
+	assert.equal(child.paused, true);
+	assert.equal(child.pausedInbox, undefined);
+	assert.throws(() => engine.queueMainDelivery("no"), /handoff/);
+	bridge.release("child-id", "lease"); bridge.release("main-id", "other");
+	assert.equal(engine.reserve("new", "main").ok, false);
+	bridge.release("main-id", "lease");
+	assert.equal(engine.reserve("new", "main").ok, true);
+});
+
+test("in-flight delivery remains owned after target removal", async () => {
+	const { engine, bridge } = fixture();
+	const gate = deferred(); const child = record("child");
+	child.handle.deliver = () => gate.promise; engine.addAgent(child);
+	const delivery = engine.route("main", "child", "work");
+	await engine.kill("main", ["child"]);
