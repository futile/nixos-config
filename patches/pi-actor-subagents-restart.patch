+import type { Engine } from "./engine.ts";
+
+export const RESTART_BRIDGE_KEY = Symbol.for("futile.pi.subagents.restart-in-dir.v1");
+
+/** Only actor-owned readiness/admission; not a core or TUI queue guarantee. */
+export function createRestartBridge(engine: Engine) {
+	return {
+		inspect: (sessionId: string) => engine.inspectRestart(sessionId),
+		acquire: (sessionId: string, token: string) => engine.acquireRestart(sessionId, token),
+		release: (sessionId: string, token: string) => engine.releaseRestart(sessionId, token),
+	};
+}
