+	const spawn = runtime.spawnAgent({ name: "child", systemPrompt: "test" }, "main");
+	await engine.kill("main", ["child"]);
+	assert.equal(engine.has("child"), false);
+	assert.equal(bridge.inspect("main-id").ready, false);
+	creation.resolve();
+	await Promise.resolve(); await Promise.resolve();
+	assert.equal(bridge.acquire("main-id", "lease").ok, false);
+	cleanup.resolve();
+	assert.equal((await spawn).ok, false);
+	assert.equal(session.disposed, true);
+	assert.equal(bridge.inspect("main-id").ready, true);
+});
+
+test("lease allows ordered normal shutdown and removed-record cleanup remains busy", async () => {
+	const { engine, bridge } = fixture();
+	const cleanup = deferred(); const child = record("child");
+	child.close = () => cleanup.promise; engine.addAgent(child);
