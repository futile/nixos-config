+// Local patch: /reload hands running jobs (and undelivered completions) to the next instance of this
+// extension instead of killing them. Reload keeps the host process, so globalThis survives it.
+const HANDOFF_KEY = Symbol.for("pi-bash-async.reload-handoff.v1");
+/** A handoff nobody adopts (extension removed or failed to load) must not leave jobs unmanaged. */
+const HANDOFF_TIMEOUT_MS = 30_000;
+type SendMessage = ExtensionAPI["sendMessage"];
+/** The live instance's side of the bundle; unset between a reload shutdown and the adopting session_start. */
+interface LiveBinding {
+	send?: SendMessage;
+	sync?: () => void;
+	backlog: Parameters<SendMessage>[];
+}
+interface Handoff {
+	manager: JobManager;
+	notifications: NotificationBatcher;
+	provider: AsyncTaskProvider;
+	jobSessions: Map<string, string>;
+	live: LiveBinding;
+	timer: ReturnType<typeof setTimeout>;
+}
+function handoffs(): Map<string, Handoff> {
+	const g = globalThis as Record<symbol, unknown>;
+	g[HANDOFF_KEY] ??= new Map<string, Handoff>();
+	return g[HANDOFF_KEY] as Map<string, Handoff>;
+}
+
+async function stopJobs(manager: JobManager, provider: AsyncTaskProvider): Promise<void> {
+	provider.shutdown();
+	manager.beginShutdown();
+	await manager.abortAndSettleAll();
+	manager.closeAllLogs();
+}
