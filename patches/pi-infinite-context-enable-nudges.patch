+++ b/extensions/infinite-context/index.test.ts
@@ -0,0 +1,148 @@
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import extension from "./index.ts";
+
+type Handler = (...args: unknown[]) => unknown;
+
+interface FakePi {
+  handlers: Map<string, Handler[]>;
+  sent: unknown[];
+}
+
+function fakePi(): FakePi {
+  const pi = {
+    handlers: new Map<string, Handler[]>(),
+    sent: [] as unknown[],
+    on(event: string, handler: Handler) {
+      const handlers = this.handlers.get(event) ?? [];
+      handlers.push(handler);
+      this.handlers.set(event, handlers);
+    },
+    registerTool() {},
+    appendEntry() {},
+    sendMessage(message: unknown) {
+      this.sent.push(message);
+    },
+  };
+  extension(pi as unknown as ExtensionAPI);
+  return pi;
+}
+
+function fakeContext(): ExtensionContext {
+  return {
+    sessionManager: {
+      buildContextEntries: () => [],
+      getBranch: () => [],
+    },
+    getContextUsage: () => ({
+      contextWindow: 1_000,
+      tokens: 750,
+      percent: 75,
+    }),
+  } as unknown as ExtensionContext;
+}
+
+async function emit(pi: FakePi, event: string, ...args: unknown[]): Promise<void> {
+  for (const handler of pi.handlers.get(event) ?? []) await handler(...args);
+}
+
+function configFile(agentDir: string, value: string): void {
+  const extensionsDir = join(agentDir, "extensions");
+  mkdirSync(extensionsDir, { recursive: true });
+  writeFileSync(join(extensionsDir, "infinite-context.json"), value);
+}
+
+async function startAndContinue(pi: FakePi): Promise<void> {
+  const ctx = fakeContext();
+  await emit(pi, "session_start", {}, ctx);
+  await emit(
+    pi,
+    "turn_end",
+    { message: { stopReason: "toolUse" }, toolResults: [{}] },
+    ctx,
+  );
+}
+
+test("default config sends a nudge at the threshold", async () => {
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  const agentDir = mkdtempSync(join(tmpdir(), "infinite-context-"));
+  process.env.PI_CODING_AGENT_DIR = agentDir;
+  try {
+    const pi = fakePi();
+    await startAndContinue(pi);
+    assert.equal(pi.sent.length, 1);
+  } finally {
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(agentDir, { recursive: true, force: true });
+  }
+});
+
+test("enableNudges false suppresses automatic notices", async () => {
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  const agentDir = mkdtempSync(join(tmpdir(), "infinite-context-"));
+  process.env.PI_CODING_AGENT_DIR = agentDir;
+  configFile(agentDir, '{"enableNudges":false}');
+  try {
+    const pi = fakePi();
+    await startAndContinue(pi);
+    assert.equal(pi.sent.length, 0);
+  } finally {
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(agentDir, { recursive: true, force: true });
+  }
+});
+
+test("invalid config warns and falls back to enabled", async () => {
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  const agentDir = mkdtempSync(join(tmpdir(), "infinite-context-"));
+  process.env.PI_CODING_AGENT_DIR = agentDir;
+  configFile(agentDir, '{"enableNudges":"no"}');
+  const warnings: unknown[][] = [];
+  const originalWarn = console.warn;
+  console.warn = (...args: unknown[]) => warnings.push(args);
+  try {
+    const pi = fakePi();
+    await startAndContinue(pi);
+    assert.equal(pi.sent.length, 1);
+
+    configFile(agentDir, "{invalid");
+    const malformed = fakePi();
+    await startAndContinue(malformed);
+    assert.equal(malformed.sent.length, 1);
+
+    assert.equal(warnings.length, 2);
+    assert.match(String(warnings[0][0]), /invalid config/);
+    assert.match(String(warnings[1][0]), /invalid config/);
+  } finally {
+    console.warn = originalWarn;
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(agentDir, { recursive: true, force: true });
+  }
+});
+
+test("session_start reloads the global setting", async () => {
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  const agentDir = mkdtempSync(join(tmpdir(), "infinite-context-"));
+  process.env.PI_CODING_AGENT_DIR = agentDir;
+  configFile(agentDir, '{"enableNudges":false}');
+  try {
+    const pi = fakePi();
+    await startAndContinue(pi);
+    assert.equal(pi.sent.length, 0);
+
+    configFile(agentDir, '{"enableNudges":true}');
+    await startAndContinue(pi);
+    assert.equal(pi.sent.length, 1);
+  } finally {
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(agentDir, { recursive: true, force: true });
+  }
+});
