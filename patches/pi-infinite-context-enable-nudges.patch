diff --git a/extensions/infinite-context/nudges-config.test.ts b/extensions/infinite-context/nudges-config.test.ts
new file mode 100644
--- /dev/null
+++ b/extensions/infinite-context/nudges-config.test.ts
@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, mkdirSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test, type TestContext } from "node:test";
+import type { ExtensionAPI, ExtensionContext, SessionEntry } from "@earendil-works/pi-coding-agent";
+import infiniteContext from "./index.ts";
+import { messageEntry, userMessage } from "./pi-test-fixtures.ts";
+
+type Handler = (event: Record<string, unknown>, ctx: ExtensionContext) => unknown;
+type Tool = Parameters<ExtensionAPI["registerTool"]>[0];
+
+function harness(t: TestContext, config?: string) {
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  const dir = mkdtempSync(join(tmpdir(), "infinite-context-nudges-"));
+  process.env.PI_CODING_AGENT_DIR = dir;
+  t.after(() => {
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+  });
+  mkdirSync(join(dir, "extensions"));
+  const setConfig = (value: string) => writeFileSync(join(dir, "extensions/infinite-context.json"), value);
+  if (config !== undefined) setConfig(config);
+  const handlers = new Map<string, Handler>();
+  const tools = new Map<string, Tool>();
+  const sent: unknown[] = [];
+  const notifications: string[] = [];
+  const entries: SessionEntry[] = [messageEntry("u1", userMessage("original ".repeat(100), 1))];
+  let tokens = 0;
+  const ctx = {
+    sessionManager: { getBranch: () => entries },
+    getContextUsage: () => ({ tokens, contextWindow: 100, percent: tokens }),
+    ui: { notify: (text: string) => notifications.push(text) },
+  } as unknown as ExtensionContext;
+  infiniteContext({
+    on: (name: string, handler: Handler) => handlers.set(name, handler),
+    registerTool: (tool: Tool) => tools.set(tool.name, tool),
+    sendMessage: (message: unknown) => sent.push(message),
+    appendEntry: (customType: string, data: unknown) => entries.push({
+      type: "custom", id: `state-${entries.length}`, parentId: entries.at(-1)!.id,
+      timestamp: new Date().toISOString(), customType, data,
+    }),
+  } as unknown as ExtensionAPI);
+  const emit = async (name: string, event: Record<string, unknown> = {}) => handlers.get(name)?.(event, ctx);
+  return {
+    tools, sent, notifications, entries, setConfig, emit,
+    execute: (name: string, params: Record<string, unknown>) => tools.get(name)!.execute("call", params, undefined, undefined, ctx),
+    async continueAt(percent: number) {
+      tokens = percent;
+      await emit("turn_end", { message: { stopReason: "toolUse" }, toolResults: [{}] });
+    },
+  };
+}
+
+for (const config of [undefined, "{}", '{"enableNudges":true}']) {
+  test(`enabled/default nudges preserve 75% and 5-point bands: ${config}`, async (t) => {
+    const h = harness(t, config);
+    await h.emit("session_start");
+    await h.continueAt(74);
+    assert.equal(h.sent.length, 0);
+    await h.continueAt(75);
+    await h.continueAt(79);
+    assert.equal(h.sent.length, 1);
+    await h.continueAt(80);
+    assert.equal(h.sent.length, 2);
+  });
+}
+
+test("disabled nudges retain all tools, folding, summary edits and every compaction block", async (t) => {
+  const h = harness(t, '{"enableNudges":false}');
+  await h.emit("session_start");
+  for (const percent of [75, 80, 99]) await h.continueAt(percent);
+  assert.equal(h.sent.length, 0);
+  assert.equal(h.tools.size, 5);
+  assert.equal(h.tools.has("context_unfold"), false);
+  assert.match((await h.execute("context_map", {})).content[0].type, /text/);
+  const fold = await h.execute("context_fold", { items: [{ from: "u1", summary: "short summary" }] });
+  const { ids, deltaTokens } = fold.details as { ids: string[]; deltaTokens: number };
+  assert.ok(deltaTokens < 0);
+  const summary = await h.execute("context_summary", { id: ids[0], summary: "" });
+  assert.equal((summary.details as { id: string }).id, ids[0]);
+  assert.ok((await h.execute("context_peek", { id: "u1" })).content.length);
+  assert.ok((await h.execute("context_search", { patterns: ["original"] })).content.length);
+  await assert.rejects(h.execute("context_summary", { id: "missing", summary: "" }));
+  const persisted = h.entries.length;
+  for (const reason of ["manual", "threshold", "overflow"]) {
+    assert.deepEqual(await h.emit("session_before_compact", { reason }), { cancel: true });
+    assert.match(h.notifications.at(-1)!, new RegExp(`blocked ${reason} compaction`));
+  }
+  assert.equal(h.entries.length, persisted);
+  assert.equal(h.sent.length, 0);
+});
+
+for (const config of ['{"enableNudges":"no"}', "{invalid", "null", "[]"]) {
+  test(`invalid config warns and defaults to enabled: ${config}`, async (t) => {
+    const h = harness(t, config);
+    const warnings: unknown[] = [];
+    t.mock.method(console, "warn", (message: unknown) => warnings.push(message));
+    await h.emit("session_start");
+    await h.continueAt(75);
+    assert.equal(h.sent.length, 1);
+    assert.equal(warnings.length, 1);
+    assert.match(String(warnings[0]), /invalid config/);
+  });
+}
+
+test("headless startup honors disabled config and session_start rereads it", async (t) => {
+  const h = harness(t, '{"enableNudges":false}');
+  await h.continueAt(80);
+  assert.equal(h.sent.length, 0);
+  h.setConfig('{"enableNudges":true}');
+  await h.emit("session_start");
+  await h.continueAt(80);
+  assert.equal(h.sent.length, 1);
+  h.setConfig('{"enableNudges":false}');
+  await h.emit("session_start");
+  await h.continueAt(90);
+  assert.equal(h.sent.length, 1);
+});
