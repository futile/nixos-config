+const DEFAULT_ENABLE_NUDGES = true;
+const NUDGE_CONFIG_FILE = "infinite-context.json";
+
+/**
+ * Read the global extension config. Pi has no settings-read API for
+ * extensions, so this follows the extension-owned config convention used by
+ * the upstream examples (`<agent dir>/extensions/<name>.json`).
+ */
+function loadNudgesEnabled(): boolean {
+  const path = join(getAgentDir(), "extensions", NUDGE_CONFIG_FILE);
+  try {
+    const value: unknown = JSON.parse(readFileSync(path, "utf8"));
+    if (typeof value !== "object" || value === null || Array.isArray(value)) {
+      throw new Error("config must be an object");
+    }
+    const enabled = (value as { enableNudges?: unknown }).enableNudges;
+    if (enabled !== undefined && typeof enabled !== "boolean") {
+      throw new Error('"enableNudges" must be a boolean');
+    }
+    return enabled ?? DEFAULT_ENABLE_NUDGES;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT")
+      return DEFAULT_ENABLE_NUDGES;
+    console.warn(
+      `[infinite-context] ignored invalid config ${path}: ${(error as Error).message}`,
+    );
+    return DEFAULT_ENABLE_NUDGES;
+  }
+}
