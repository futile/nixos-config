+export interface ResumeSummary {
+	wasPaused: boolean;
+	retriggered: number;
+	bufferedMessages: number;
+}
+
+/** Explain global pause release separately from per-agent interrupted-turn nudges. */
+export function formatResumeResult(result: ResumeSummary): string {
+	if (!result.wasPaused) return "swarm was already live; budget re-armed";
+	const details: string[] = [];
+	if (result.bufferedMessages) details.push(`delivered ${result.bufferedMessages} buffered message(s)`);
+	if (result.retriggered) details.push(`re-triggered ${result.retriggered} interrupted agent(s)`);
+	return `resumed paused swarm; budget re-armed${details.length ? `; ${details.join("; ")}` : ""}`;
+}
