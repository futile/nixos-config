diff --git a/DESIGN.md b/DESIGN.md
index cbe95a0..703c0fe 100644
--- a/DESIGN.md
+++ b/DESIGN.md
@@ -18,7 +18,7 @@ Each child session is created with:
 - the extension paths granted by the `childExtensions` policy in `settings.json`; and
 - a headless UI context (`headless-ui-context.ts`), bound with mode `rpc`.
 
-Children have no terminal, but their extensions' footer statuses (`ctx.ui.setStatus`) belong in the roster. A child is therefore a headless UI host, like Pi's RPC mode: `setStatus` is captured and every other UI method keeps Pi's no-op behavior, so dialogs resolve as cancelled. Extensions see `ctx.hasUI === true` and `ctx.mode === "rpc"`, the documented pair for a UI host without a terminal. The statuses are sanitized to plain text at that boundary (`extension-status.ts`) and owned by the child session, so a late write from a killed child cannot reach a re-spawned namesake. They are not persisted: extensions publish them again on `session_start`. Three status sources stay separate by provenance: the system status is derived by the host, `set_status` is reported by the agent, extension statuses by its extensions. The roster joins extension statuses into one last column, as Pi's footer does; `list_subagents` shows them with their keys.
+Children have no terminal, but their extensions' footer statuses (`ctx.ui.setStatus`) belong in the roster. A child is therefore a headless UI host, like Pi's RPC mode: `setStatus` is captured and every other UI method keeps Pi's no-op behavior, so dialogs resolve as cancelled. Extensions see `ctx.hasUI === true` and `ctx.mode === "rpc"`, the documented pair for a UI host without a terminal. The statuses are sanitized to plain text at that boundary (`extension-status.ts`) and, if `childExtensionStatusKeys` is set in `settings.json`, filtered to those keys there (display-only, so an invalid value shows every key). They are owned by the child session, so a late write from a killed child cannot reach a re-spawned namesake. They are not persisted: extensions publish them again on `session_start`. Three status sources stay separate by provenance: the system status is derived by the host, `set_status` is reported by the agent, extension statuses by its extensions. The roster joins extension statuses into one last column, as Pi's footer does; `list_subagents` shows them with their keys.
 
 A pi hook only fires in the session that registered it, so the timestamp that lets an agent perceive elapsed time has to be installed into every child separately. It travels the same in-process route as the orchestration tools rather than as a file path, which keeps the granted-paths list an exact picture of the foreign-capability policy. The policy is read on every spawn. Parsing is fail-closed: missing, unreadable, malformed, or structurally invalid input becomes an empty list. actor-subagents itself is not loaded recursively in children because its tools are already injected.
 
diff --git a/README.md b/README.md
index 52b4804..8796dbc 100644
--- a/README.md
+++ b/README.md
@@ -45,13 +45,15 @@ Optional file: `~/.pi/agent/actor-subagents/settings.json` (inside Pi's configur
   "maxSpawnDepth": 3,
   "childExtensions": [
     "~/.pi/agent/npm/node_modules/pi-infinite-context/extensions/infinite-context/index.ts"
-  ]
+  ],
+  "childExtensionStatusKeys": ["bash-async"]
 }
 ```
 
 - `maxAgents`: maximum live background agents (default: `8`).
 - `maxSpawnDepth`: maximum hierarchy depth (default: `3`). Both limits must be positive integers; missing or invalid values use their defaults. Changes apply after restarting Pi.
 - `childExtensions`: extension whitelist for subagents (default: `[]`). List extension files or directories; children do not inherit Pi's discovered extensions. Actor-subagents' orchestration tools are always available and need no whitelist entry. Changes apply to newly spawned agents. The example path assumes `pi install npm:pi-infinite-context` in the default Pi setup. Child extensions run with `ctx.mode === "rpc"` and `ctx.hasUI === true`: their `ctx.ui.setStatus` texts appear in the roster and in `list_subagents`, and dialogs (`confirm`, `select`, `input`, …) resolve as cancelled.
+- `childExtensionStatusKeys`: status keys shown in the roster and in `list_subagents` of subagents (default: unset, which shows every key). Statuses with other keys are ignored. An invalid value shows every key. Changes apply to newly spawned agents.
 
 ## Coordination
 
diff --git a/extensions/actor-subagents/extension-status.test.ts b/extensions/actor-subagents/extension-status.test.ts
index 0d18dda..03c6f97 100644
--- a/extensions/actor-subagents/extension-status.test.ts
+++ b/extensions/actor-subagents/extension-status.test.ts
@@ -49,3 +49,13 @@ test("formatting sorts by key: plain values for the roster, key: value for the L
 	assert.equal(formatExtensionStatuses(undefined), "");
 	assert.equal(describeExtensionStatuses({}), "");
 });
+
+test("withExtensionStatus ignores keys outside allowedKeys", () => {
+	const allowed = ["bash-async"];
+	const s = withExtensionStatus({}, "bash-async", "⏳1", allowed);
+	assert.deepEqual(s, { "bash-async": "⏳1" });
+	assert.equal(withExtensionStatus(s, "mcp", "MCP 0/4", allowed), s);
+	const empty = {};
+	assert.equal(withExtensionStatus(empty, "bash-async", "⏳1", []), empty, "an empty list shows nothing");
+	assert.deepEqual(withExtensionStatus(s, "bash-async", undefined, allowed), {});
+});
diff --git a/extensions/actor-subagents/extension-status.ts b/extensions/actor-subagents/extension-status.ts
index 1288bfa..b92eb74 100644
--- a/extensions/actor-subagents/extension-status.ts
+++ b/extensions/actor-subagents/extension-status.ts
@@ -35,14 +35,16 @@ export function sanitizeStatusText(text: string): string {
  * renders hold a snapshot safely. Text that is empty after sanitizing clears the key, like
  * `undefined` does. Both arguments come from untyped extension code, so non-strings are treated
  * as a clear (text) or ignored (key), and the key is sanitized too: it reaches the LLM listing.
+ * With `allowedKeys` (the `childExtensionStatusKeys` setting), every other key is ignored.
  */
 export function withExtensionStatus(
 	statuses: ExtensionStatuses,
 	rawKey: unknown,
 	text: unknown,
+	allowedKeys?: readonly string[],
 ): ExtensionStatuses {
 	const key = typeof rawKey === "string" ? sanitizeStatusText(rawKey) : "";
-	if (key === "") return statuses;
+	if (key === "" || (allowedKeys && !allowedKeys.includes(key))) return statuses;
 	const value = typeof text === "string" ? sanitizeStatusText(text) : "";
 	if (value === "") {
 		if (!(key in statuses)) return statuses;
