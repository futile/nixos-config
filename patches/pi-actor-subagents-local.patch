diff --git a/extensions/actor-subagents/fast-control.test.ts b/extensions/actor-subagents/fast-control.test.ts
new file mode 100644
index 0000000..71d5500
--- /dev/null
+++ b/extensions/actor-subagents/fast-control.test.ts
@@ -0,0 +1,68 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import {
+	FAST_ROSTER_MARKER,
+	describeFastState,
+	readFastState,
+	setFastDesired,
+	setOwnedAgentFast,
+	type FastState,
+} from "./fast-control.ts";
+
+const KEY = Symbol.for("futile.pi.codex-fast.registry.v1");
+function install(states: Record<string, FastState>): void {
+	const controllers = new Map(Object.entries(states).map(([id, initial]) => {
+		let state = initial;
+		return [id, {
+			owner: Symbol(id),
+			controller: {
+				getState: () => state,
+				setDesired: (enabled: boolean) => {
+					state = { ...state, desired: enabled, effective: enabled && state.effective };
+					return state;
+				},
+			},
+		}] as const;
+	}));
+	(globalThis as Record<symbol, unknown>)[KEY] = { version: 1, controllers };
+}
+afterEach(() => { delete (globalThis as Record<symbol, unknown>)[KEY]; });
+
+test("reads and updates the versioned controller registry", () => {
+	install({ main: { desired: false, effective: false, model: { provider: "openai-codex", id: "gpt-5.6-sol" } } });
+	assert.equal(readFastState("main")?.desired, false);
+	const result = setFastDesired("main", true);
+	assert.equal(result.ok, true);
+	if (result.ok) assert.equal(result.state.desired, true);
+	assert.equal(setFastDesired("missing", true).ok, false);
+});
+
+test("enforces direct-owner authorization and explicit false", () => {
+	install({
+		main: { desired: true, effective: true },
+		lead: { desired: false, effective: false },
+		worker: { desired: true, effective: true, model: { provider: "openai-codex", id: "gpt-5.6-sol" } },
+		sibling: { desired: false, effective: false },
+	});
+	const agents = [
+		{ name: "main", spawnedBy: "main", sessionId: "main" },
+		{ name: "lead", spawnedBy: "main", sessionId: "lead" },
+		{ name: "worker", spawnedBy: "lead", sessionId: "worker" },
