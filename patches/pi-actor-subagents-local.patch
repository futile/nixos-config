diff --git a/extensions/actor-subagents/fast-control.ts b/extensions/actor-subagents/fast-control.ts
new file mode 100644
index 0000000..93a21e2
--- /dev/null
+++ b/extensions/actor-subagents/fast-control.ts
@@ -0,0 +1,104 @@
+/** SDK-free bridge to the per-session Codex Fast extension. */
+export interface FastModel {
+	provider: string;
+	id: string;
+}
+
+export interface FastState {
+	desired: boolean;
+	effective: boolean;
+	model?: FastModel;
+}
+
+interface FastController {
+	getState(): FastState;
+	setDesired(enabled: boolean): FastState;
+}
+
+interface FastRegistryEntry {
+	owner: symbol;
+	controller: FastController;
+}
+
+interface FastRegistry {
+	version: 1;
+	controllers: Map<string, FastRegistryEntry>;
+}
+
+export interface FastAgentRef {
+	name: string;
+	spawnedBy: string;
+	sessionId?: string;
+}
+
+export type FastControlResult =
+	| { ok: true; agent: string; state: FastState }
+	| { ok: false; reason: string };
+
+export const FAST_ROSTER_MARKER = "⚡ fast";
+const FAST_REGISTRY_KEY = Symbol.for("futile.pi.codex-fast.registry.v1");
+
+function registry(): FastRegistry | undefined {
+	const value = (globalThis as Record<symbol, unknown>)[FAST_REGISTRY_KEY] as FastRegistry | undefined;
+	return value?.version === 1 && value.controllers instanceof Map ? value : undefined;
+}
+
+function isFastState(value: unknown): value is FastState {
+	if (!value || typeof value !== "object") return false;
+	const state = value as Partial<FastState>;
+	if (typeof state.desired !== "boolean" || typeof state.effective !== "boolean") return false;
+	if (state.effective && !state.desired) return false;
+	return state.model === undefined || (
+		typeof state.model === "object" &&
+		state.model !== null &&
+		typeof state.model.provider === "string" &&
+		typeof state.model.id === "string"
+	);
+}
+
+export function readFastState(sessionId: string | undefined): FastState | undefined {
+	if (!sessionId) return undefined;
+	try {
+		const state = registry()?.controllers.get(sessionId)?.controller.getState();
+		return isFastState(state) ? state : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+export function setFastDesired(sessionId: string | undefined, enabled: boolean): FastControlResult {
+	if (!sessionId) return { ok: false, reason: "agent has no live Pi session" };
+	const controller = registry()?.controllers.get(sessionId)?.controller;
+	if (!controller) return { ok: false, reason: "Fast controller is unavailable for this session" };
+	try {
+		const state = controller.setDesired(enabled);
+		if (!isFastState(state)) return { ok: false, reason: "Fast controller returned an invalid state" };
+		return { ok: true, agent: "", state };
+	} catch (error) {
+		return { ok: false, reason: `Fast controller failed: ${error instanceof Error ? error.message : String(error)}` };
+	}
+}
+
+export function setOwnedAgentFast(
+	agents: readonly FastAgentRef[],
+	selfName: string,
+	targetName: string | undefined,
+	enabled: boolean,
+): FastControlResult {
+	const name = targetName ?? selfName;
+	const target = agents.find((agent) => agent.name === name);
+	if (!target) return { ok: false, reason: `unknown agent '${name}'` };
+	if (name !== selfName && target.spawnedBy !== selfName) {
+		return { ok: false, reason: `agent '${name}' is not a directly owned child of '${selfName}'` };
+	}
+	const result = setFastDesired(target.sessionId, enabled);
+	return result.ok ? { ...result, agent: name } : result;
+}
+
+export function describeFastState(state: FastState): string {
+	const desired = state.desired ? "on" : "off";
+	const effective = state.effective ? "on" : "off";
+	const model = state.model ? `${state.model.provider}/${state.model.id}` : "no active model";
+	const reason = state.desired && !state.effective ? `; unsupported model: ${model}` : `; model: ${model}`;
+	return `Fast desired ${desired}; effective ${effective}${reason}`;
+}
