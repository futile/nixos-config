+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+	ActivityPublisher,
+	hasActiveBackgroundAgent,
+	installActivityNotifier,
+	isBackgroundAgentActive,
+	notifyActivity,
+	subagentsActivityUpdate,
+} from "./activity.ts";
+
+test("background activity follows pending, turn, and compaction work", () => {
+	assert.equal(isBackgroundAgentActive({ name: "x", pending: true }), true);
+	assert.equal(isBackgroundAgentActive({ name: "x", activity: "thinking" }), true);
+	assert.equal(isBackgroundAgentActive({ name: "x", compacting: true }), true);
+	assert.equal(isBackgroundAgentActive({ name: "main", activity: "thinking" }), false);
+	assert.equal(hasActiveBackgroundAgent([
+		{ name: "one", activity: undefined },
+		{ name: "two", compacting: true },
+	]), true);
+	assert.equal(hasActiveBackgroundAgent([{ name: "one", activity: undefined }]), false);
+});
+
+test("activity source keeps raw work independent from terminal progress policy", () => {
+	assert.deepEqual(subagentsActivityUpdate(true, false), {
+		version: 1,
+		source: "fdietze-subagents",
+		active: true,
+		terminalProgress: false,
+	});
+	assert.equal(subagentsActivityUpdate(false, true).terminalProgress, false);
+});
+
+test("publisher emits activity and setting changes without losing raw active state", async () => {
+	let active = true;
+	let terminal = true;
+	const updates: ReturnType<typeof subagentsActivityUpdate>[] = [];
+	const publisher = new ActivityPublisher({
+		readActive: () => active,
+		readTerminalProgressEnabled: async () => terminal,
+		emit: (update) => updates.push(update),
+		pollMs: 60_000,
+	});
+	publisher.notify(true);
+	await publisher.refreshTerminalProgress();
+	await new Promise<void>((resolve) => setImmediate(resolve));
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, true));
+	terminal = false;
+	await publisher.refreshTerminalProgress();
+	await new Promise<void>((resolve) => setImmediate(resolve));
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, false));
+	active = false;
+	publisher.notify();
+	await new Promise<void>((resolve) => setImmediate(resolve));
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(false, false));
+	publisher.dispose();
+});
+
+test("retained callbacks resolve the newest reload notifier", () => {
+	const calls: string[] = [];
+	const clearOld = installActivityNotifier(() => calls.push("old"));
+	const retained = notifyActivity;
+	retained();
+	const clearNew = installActivityNotifier(() => calls.push("new"));
+	retained();
+	clearOld();
+	retained();
+	clearNew();
+	retained();
+	assert.deepEqual(calls, ["old", "new", "new"]);
+});
