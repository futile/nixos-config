new file mode 100644
index 0000000..ed108dd
--- /dev/null
+++ b/extensions/actor-subagents/activity.test.ts
@@ -0,0 +1,71 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+	ActivityPublisher,
+	hasActiveBackgroundAgent,
+	installActivityNotifier,
+	isBackgroundAgentActive,
+	notifyActivity,
+	subagentsActivityUpdate,
+} from "./activity.ts";
+
+test("background activity follows pending, turn, and compaction work", () => {
+	assert.equal(isBackgroundAgentActive({ name: "x", pending: true }), true);
+	assert.equal(isBackgroundAgentActive({ name: "x", activity: "thinking" }), true);
+	assert.equal(isBackgroundAgentActive({ name: "x", compacting: true }), true);
+	assert.equal(isBackgroundAgentActive({ name: "main", activity: "thinking" }), false);
+	assert.equal(hasActiveBackgroundAgent([
+		{ name: "one", activity: undefined },
+		{ name: "two", compacting: true },
+	]), true);
+	assert.equal(hasActiveBackgroundAgent([{ name: "one", activity: undefined }]), false);
+});
+
+test("activity source keeps raw work independent from terminal progress policy", () => {
+	assert.deepEqual(subagentsActivityUpdate(true, false), {
+		version: 1,
+		source: "fdietze-subagents",
+		active: true,
+		terminalProgress: false,
+	});
+	assert.equal(subagentsActivityUpdate(false, true).terminalProgress, false);
+});
+
+test("publisher emits activity and setting changes without losing raw active state", async () => {
+	let active = true;
+	let terminal = true;
+	const updates: ReturnType<typeof subagentsActivityUpdate>[] = [];
+	const publisher = new ActivityPublisher({
+		readActive: () => active,
+		readTerminalProgressEnabled: async () => terminal,
+		emit: (update) => updates.push(update),
+		pollMs: 60_000,
+	});
+	publisher.notify(true);
+	await publisher.refreshTerminalProgress();
+	await new Promise<void>((resolve) => setImmediate(resolve));
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, true));
+	terminal = false;
+	await publisher.refreshTerminalProgress();
+	await new Promise<void>((resolve) => setImmediate(resolve));
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, false));
+	active = false;
+	publisher.notify();
+	await new Promise<void>((resolve) => setImmediate(resolve));
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(false, false));
+	publisher.dispose();
+});
+
+test("retained callbacks resolve the newest reload notifier", () => {
+	const calls: string[] = [];
+	const clearOld = installActivityNotifier(() => calls.push("old"));
+	const retained = notifyActivity;
+	retained();
+	const clearNew = installActivityNotifier(() => calls.push("new"));
+	retained();
+	clearOld();
+	retained();
+	clearNew();
+	retained();
+	assert.deepEqual(calls, ["old", "new", "new"]);
+});
diff --git a/extensions/actor-subagents/activity.ts b/extensions/actor-subagents/activity.ts
new file mode 100644
index 0000000..bb8860a
--- /dev/null
+++ b/extensions/actor-subagents/activity.ts
@@ -0,0 +1,161 @@
+/** Aggregate background work over Pi's shared foreground extension event bus. */
+import type { AgentRecord } from "./agent-record.ts";
+
+export const AGENT_ACTIVITY_UPDATE_EVENT = "pi.agent-activity.v1:update";
+export const AGENT_ACTIVITY_REQUEST_EVENT = "pi.agent-activity.v1:request";
+export const SUBAGENTS_ACTIVITY_SOURCE = "fdietze-subagents";
+
+export interface AgentActivitySourceUpdate {
+	version: 1;
+	source: string;
+	/** Raw work state, independent of presentation settings. */
+	active: boolean;
+	/** Whether this source currently requests terminal OSC progress. */
+	terminalProgress: boolean;
+}
+
+/** A background record contributes while asynchronous work remains unsettled. */
+export function isBackgroundAgentActive(
+	rec: Pick<AgentRecord, "name"> & Partial<Pick<AgentRecord, "pending" | "activity" | "compacting">>,
+): boolean {
+	return rec.name !== "main" && Boolean(rec.pending || rec.activity || rec.compacting);
+}
+
+/** Union activity: concurrent records intentionally count as one wall-clock interval. */
+export function hasActiveBackgroundAgent(
+	records: Iterable<Pick<AgentRecord, "name"> & Partial<Pick<AgentRecord, "pending" | "activity" | "compacting">>>,
+): boolean {
+	for (const rec of records) {
+		if (isBackgroundAgentActive(rec)) return true;
+	}
+	return false;
+}
+
+export function subagentsActivityUpdate(active: boolean, terminalProgressEnabled: boolean): AgentActivitySourceUpdate {
+	return {
+		version: 1,
+		source: SUBAGENTS_ACTIVITY_SOURCE,
+		active,
+		terminalProgress: active && terminalProgressEnabled,
+	};
+}
+
+export interface ActivityPublisherOptions {
+	readActive(): boolean;
+	readTerminalProgressEnabled(): Promise<boolean>;
+	emit(update: AgentActivitySourceUpdate): void;
+	pollMs?: number;
+}
+
+/** Coalesced, reload-disposable publisher for the foreground event bus. */
+export class ActivityPublisher {
+	private readonly options: ActivityPublisherOptions;
+	private active: boolean;
+	private terminalProgressEnabled = false;
+	private lastPublished: string | undefined;
+	private queued = false;
+	private forceQueued = false;
+	private refreshPromise: Promise<void> | undefined;
+	private poll: ReturnType<typeof setInterval> | undefined;
+	private disposed = false;
+
+	constructor(options: ActivityPublisherOptions) {
+		this.options = options;
+		this.active = options.readActive();
+	}
+
+	notify(force = false): void {
+		if (this.disposed) return;
+		const next = this.options.readActive();
+		const changed = next !== this.active;
+		if (next && !this.active) this.terminalProgressEnabled = false;
+		this.active = next;
+		this.syncPoll();
+		if (force || changed) {
+			this.schedule(force);
+			void this.refreshTerminalProgress();
+		}
+	}
+
+	refreshTerminalProgress(): Promise<void> {
+		if (this.disposed) return Promise.resolve();
+		if (this.refreshPromise) return this.refreshPromise;
+		this.refreshPromise = (async () => {
+			let next = false;
+			try {
+				next = await this.options.readTerminalProgressEnabled();
+			} catch {
+				/* fail closed */
+			}
+			if (!this.disposed && next !== this.terminalProgressEnabled) {
+				this.terminalProgressEnabled = next;
+				this.schedule();
+			}
+		})().finally(() => {
+			this.refreshPromise = undefined;
+		});
+		return this.refreshPromise;
+	}
+
+	dispose(): void {
+		if (this.disposed) return;
+		this.disposed = true;
+		if (this.poll) clearInterval(this.poll);
+		this.poll = undefined;
+	}
+
+	private syncPoll(): void {
+		if (this.active && !this.poll) {
+			this.poll = setInterval(() => void this.refreshTerminalProgress(), this.options.pollMs ?? 1_000);
+			this.poll.unref?.();
+		} else if (!this.active && this.poll) {
+			clearInterval(this.poll);
+			this.poll = undefined;
+		}
+	}
+
+	private schedule(force = false): void {
+		this.forceQueued ||= force;
+		if (this.queued) return;
+		this.queued = true;
+		queueMicrotask(() => {
+			this.queued = false;
+			if (this.disposed) return;
+			const shouldForce = this.forceQueued;
+			this.forceQueued = false;
+			const update = subagentsActivityUpdate(this.active, this.terminalProgressEnabled);
+			const key = `${update.active}:${update.terminalProgress}`;
+			if (!shouldForce && key === this.lastPublished) return;
+			try {
+				this.options.emit(update);
+				this.lastPublished = key;
+			} catch {
+				/* A reload can invalidate the event bus while a queued microtask drains. */
+			}
+		});
+	}
+}
+
+const ACTIVITY_NOTIFIER_KEY = "__fdietzeSubagentsActivityNotifier_v1";
+type ActivityNotifier = { owner: symbol; notify: () => void };
+
+/** Install the latest foreground notifier; cleanup cannot remove a newer reload's notifier. */
+export function installActivityNotifier(notify: () => void): () => void {
+	const owner = Symbol("subagents-activity-notifier");
+	const global = globalThis as Record<string, unknown>;
+	global[ACTIVITY_NOTIFIER_KEY] = { owner, notify } satisfies ActivityNotifier;
+	return () => {
+		const current = global[ACTIVITY_NOTIFIER_KEY] as ActivityNotifier | undefined;
+		if (current?.owner === owner) delete global[ACTIVITY_NOTIFIER_KEY];
+	};
+}
+
+/** Retained child callbacks resolve the current foreground runtime. */
+export function notifyActivity(): void {
+	const notifier = (globalThis as Record<string, unknown>)[ACTIVITY_NOTIFIER_KEY] as ActivityNotifier | undefined;
+	try {
+		notifier?.notify();
+	} catch {
+		/* Observability is best-effort and must never fail a child lifecycle event. */
+	}
+}
