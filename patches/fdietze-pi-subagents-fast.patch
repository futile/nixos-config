new file mode 100644
index 0000000..b002641
--- /dev/null
+++ b/fast-control.test.ts
@@ -0,0 +1,133 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import {
+  FAST_ROSTER_MARKER,
+  describeFastState,
+  readFastState,
+  setFastDesired,
+  setOwnedAgentFast,
+  type FastState,
+} from "./fast-control.ts";
+
+const KEY = Symbol.for("futile.pi.codex-fast.registry.v1");
+
+function install(states: Record<string, FastState>) {
+  const controllers = new Map(
+    Object.entries(states).map(([sessionId, initial]) => {
+      let state = initial;
+      return [
+        sessionId,
+        {
+          owner: Symbol(sessionId),
+          controller: {
+            getState: () => state,
+            setDesired: (enabled: boolean) => {
+              state = { ...state, desired: enabled, effective: enabled && state.model?.provider === "openai-codex" };
+              return state;
+            },
+          },
+        },
+      ] as const;
+    }),
+  );
+  (globalThis as Record<symbol, unknown>)[KEY] = { version: 1, controllers };
+}
+
+afterEach(() => {
+  delete (globalThis as Record<symbol, unknown>)[KEY];
+});
+
+test("reads and updates only controllers in the versioned Fast registry", () => {
+  install({
+    main: {
+      desired: false,
+      effective: false,
+      model: { provider: "openai-codex", id: "gpt-5.6-sol" },
+    },
+  });
+  assert.equal(readFastState("main")?.desired, false);
+  const changed = setFastDesired("main", true);
+  assert.equal(changed.ok, true);
+  if (changed.ok) assert.deepEqual(changed.state, {
+    desired: true,
+    effective: true,
+    model: { provider: "openai-codex", id: "gpt-5.6-sol" },
+  });
+  assert.equal(setFastDesired("missing", true).ok, false);
+});
+
+test("malformed registries and controllers fail closed", () => {
+  const globals = globalThis as Record<symbol, unknown>;
+
+  for (const malformed of [
+    { version: 2, controllers: new Map() },
+    { version: 1, controllers: {} },
+  ]) {
+    globals[KEY] = malformed;
+    assert.equal(readFastState("main"), undefined);
+    assert.equal(setFastDesired("main", true).ok, false);
+  }
+
+  globals[KEY] = {
+    version: 1,
+    controllers: new Map([
+      ["throwing", {
+        owner: Symbol("throwing"),
+        controller: {
+          getState: () => { throw new Error("get exploded"); },
+          setDesired: () => { throw new Error("set exploded"); },
+        },
+      }],
+      ["invalid", {
+        owner: Symbol("invalid"),
+        controller: {
+          getState: () => ({ desired: false, effective: true }),
+          setDesired: () => ({ desired: true, effective: true, model: { provider: 42, id: "gpt-5.6-sol" } }),
+        },
+      }],
+      ["missing-controller", { owner: Symbol("missing") }],
+    ]),
+  };
+  assert.equal(readFastState("throwing"), undefined);
+  const throwing = setFastDesired("throwing", true);
+  assert.equal(throwing.ok, false);
+  if (!throwing.ok) assert.match(throwing.reason, /failed.*set exploded/i);
+  assert.equal(readFastState("invalid"), undefined);
+  const invalid = setFastDesired("invalid", true);
+  assert.equal(invalid.ok, false);
+  if (!invalid.ok) assert.match(invalid.reason, /invalid state/i);
+  assert.equal(readFastState("missing-controller"), undefined);
+  assert.equal(setFastDesired("missing-controller", true).ok, false);
+});
+
+test("direct owners can control self and children but not parents, siblings, or unrelated agents", () => {
+  install({
+    lead: { desired: false, effective: false },
+    worker: { desired: false, effective: false },
+    sibling: { desired: false, effective: false },
+  });
+  const agents = [
+    { name: "main", spawnedBy: "main", sessionId: "main" },
+    { name: "lead", spawnedBy: "main", sessionId: "lead" },
+    { name: "worker", spawnedBy: "lead", sessionId: "worker" },
+    { name: "sibling", spawnedBy: "main", sessionId: "sibling" },
+  ];
+  assert.equal(setOwnedAgentFast(agents, "lead", undefined, true).ok, true, "self");
+  assert.equal(setOwnedAgentFast(agents, "lead", "worker", true).ok, true, "direct child");
+  for (const target of ["main", "sibling"]) {
+    const result = setOwnedAgentFast(agents, "lead", target, true);
+    assert.equal(result.ok, false, target);
+    if (!result.ok) assert.match(result.reason, /directly owned child/i);
+  }
+  assert.equal(setOwnedAgentFast(agents, "lead", "unknown", true).ok, false);
+});
+
+test("desired-but-ineligible state is diagnosed without an effective roster marker", () => {
+  const unsupported: FastState = {
+    desired: true,
+    effective: false,
+    model: { provider: "anthropic", id: "claude-opus-4-6" },
+  };
+  assert.match(describeFastState(unsupported), /desired on.*effective off.*unsupported/i);
+  assert.equal(FAST_ROSTER_MARKER, "󱐋 fast");
+});
diff --git a/fast-control.ts b/fast-control.ts
new file mode 100644
index 0000000..f428d73
--- /dev/null
+++ b/fast-control.ts
@@ -0,0 +1,103 @@
+export interface FastModel {
+	provider: string;
+	id: string;
+}
+
+export interface FastState {
+	desired: boolean;
+	effective: boolean;
+	model?: FastModel;
+}
+
+interface FastController {
+	getState(): FastState;
+	setDesired(enabled: boolean): FastState;
+}
+
+interface FastRegistryEntry {
+	owner: symbol;
+	controller: FastController;
+}
+
+interface FastRegistry {
+	version: 1;
+	controllers: Map<string, FastRegistryEntry>;
+}
+
+export interface FastAgentRef {
+	name: string;
+	spawnedBy: string;
+	sessionId?: string;
+}
+
+export type FastControlResult =
+	| { ok: true; agent: string; state: FastState }
+	| { ok: false; reason: string };
+
+export const FAST_ROSTER_MARKER = "󱐋 fast";
+const FAST_REGISTRY_KEY = Symbol.for("futile.pi.codex-fast.registry.v1");
+
+function registry(): FastRegistry | undefined {
+	const value = (globalThis as Record<symbol, unknown>)[FAST_REGISTRY_KEY] as FastRegistry | undefined;
+	return value?.version === 1 && value.controllers instanceof Map ? value : undefined;
+}
+
+function isFastState(value: unknown): value is FastState {
+	if (!value || typeof value !== "object") return false;
+	const state = value as Partial<FastState>;
+	if (typeof state.desired !== "boolean" || typeof state.effective !== "boolean") return false;
+	if (state.effective && !state.desired) return false;
+	return state.model === undefined || (
+		typeof state.model === "object" &&
+		state.model !== null &&
+		typeof state.model.provider === "string" &&
+		typeof state.model.id === "string"
+	);
+}
+
+export function readFastState(sessionId: string | undefined): FastState | undefined {
+	if (!sessionId) return undefined;
+	try {
+		const state = registry()?.controllers.get(sessionId)?.controller.getState();
+		return isFastState(state) ? state : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+export function setFastDesired(sessionId: string | undefined, enabled: boolean): FastControlResult {
+	if (!sessionId) return { ok: false, reason: "agent has no live Pi session" };
+	const controller = registry()?.controllers.get(sessionId)?.controller;
+	if (!controller) return { ok: false, reason: "Fast controller is unavailable for this session" };
+	try {
+		const state = controller.setDesired(enabled);
+		if (!isFastState(state)) return { ok: false, reason: "Fast controller returned an invalid state" };
+		return { ok: true, agent: "", state };
+	} catch (error) {
+		return { ok: false, reason: `Fast controller failed: ${error instanceof Error ? error.message : String(error)}` };
+	}
+}
+
+export function setOwnedAgentFast(
+	agents: readonly FastAgentRef[],
+	selfName: string,
+	targetName: string | undefined,
+	enabled: boolean,
+): FastControlResult {
+	const name = targetName ?? selfName;
+	const target = agents.find((agent) => agent.name === name);
+	if (!target) return { ok: false, reason: `unknown agent '${name}'` };
+	if (name !== selfName && target.spawnedBy !== selfName) {
+		return { ok: false, reason: `agent '${name}' is not a directly owned child of '${selfName}'` };
+	}
+	const result = setFastDesired(target.sessionId, enabled);
+	return result.ok ? { ...result, agent: name } : result;
+}
+
+export function describeFastState(state: FastState): string {
+	const desired = state.desired ? "on" : "off";
+	const effective = state.effective ? "on" : "off";
+	const model = state.model ? `${state.model.provider}/${state.model.id}` : "no active model";
+	const reason = state.desired && !state.effective ? `; unsupported model: ${model}` : `; model: ${model}`;
+	return `Fast desired ${desired}; effective ${effective}${reason}`;
+}
