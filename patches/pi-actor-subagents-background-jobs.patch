new file mode 100644
index 0000000..b2f0bda
--- /dev/null
+++ b/extensions/actor-subagents/background-jobs.ts
@@ -0,0 +1,84 @@
+/**
+ * Background jobs an agent still waits on, as announced by the bash-async extension
+ * (`pi.bash-async.v1`, a local patch of @ryan_nookpi/pi-extension-bash-async). An idle agent with
+ * unsettled jobs is not done: their completions will wake it. SDK-free like the rest of the engine.
+ */
+export const BASH_ASYNC_JOBS_EVENT = "pi.bash-async.v1:jobs";
+export const BASH_ASYNC_JOBS_REQUEST_EVENT = "pi.bash-async.v1:request";
+
+export interface BackgroundJob {
+	id: string;
+	title: string;
+}
+
+/** Validates a bus payload; anything malformed or from another version is ignored. */
+export function parseJobsUpdate(value: unknown): BackgroundJob[] | undefined {
+	if (!value || typeof value !== "object") return undefined;
+	const update = value as { version?: unknown; jobs?: unknown };
+	if (update.version !== 1 || !Array.isArray(update.jobs)) return undefined;
+	const jobs: BackgroundJob[] = [];
+	for (const job of update.jobs as { id?: unknown; title?: unknown }[]) {
+		if (typeof job?.id !== "string") return undefined;
+		jobs.push({
+			id: job.id,
+			title: typeof job.title === "string" ? job.title : "",
+		});
+	}
+	return jobs;
+}
+
+/** Roster/state-line cell: "" for none, "⏳N" for N jobs. */
+export function jobsIndicator(count: number): string {
+	if (count <= 0) return "";
+	return `⏳${count}`;
+}
+
+/** Text for the model (list_subagents): plain words instead of a glyph. */
+export function describeJobCount(count: number): string {
+	return count === 1 ? "1 bg job" : `${count} bg jobs`;
+}
+
+type Bus = {
+	on(channel: string, handler: (data: unknown) => void): () => void;
+	emit(channel: string, data: unknown): void;
+};
+type Hooks = {
+	on(event: "session_start", handler: (event: unknown, ctx: { sessionManager: { getSessionId(): string } }) => void): void;
+};
+
+/**
+ * Follow one session's bash-async announcements on that session's own extension bus and hand
+ * them to `apply`, keyed by the session id (not the agent name, which a respawn can reuse).
+ * The request at session_start covers either extension load order and /reload adoption.
+ */
+export function watchBackgroundJobs(
+	pi: Hooks & { events: Bus },
+	apply: (sessionId: string, jobs: BackgroundJob[]) => void,
+): void {
+	let sessionId: string | undefined;
+	pi.on("session_start", (_event, ctx) => {
+		sessionId = ctx.sessionManager.getSessionId();
+		// Forget jobs from before a /reload; a live bash-async answers the request synchronously.
+		apply(sessionId, []);
+		pi.events.emit(BASH_ASYNC_JOBS_REQUEST_EVENT, undefined);
+	});
+	pi.events.on(BASH_ASYNC_JOBS_EVENT, (data) => {
+		const jobs = parseJobsUpdate(data);
+		if (jobs && sessionId) apply(sessionId, jobs);
+	});
+}
+
+const TITLE_MAX = 40;
+const clip = (s: string) => (s.length > TITLE_MAX ? `${s.slice(0, TITLE_MAX - 1)}…` : s);
+
+/**
+ * Kill-result detail naming the jobs that died with the killed agents. `before` is a snapshot
+ * taken before the kill: the records are gone afterwards.
+ */
+export function killedJobsDetails(before: Map<string, BackgroundJob[] | undefined>, affected: string[]): string[] {
+	const parts = affected.flatMap((name) => {
+		const jobs = before.get(name) ?? [];
+		return jobs.length ? [`${name}: ${jobs.map((j) => JSON.stringify(clip(j.title || j.id))).join(", ")}`] : [];
+	});
+	return parts.length ? [`stopped background jobs of ${parts.join("; ")}`] : [];
+}
