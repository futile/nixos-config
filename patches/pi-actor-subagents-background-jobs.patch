+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+	BASH_ASYNC_JOBS_EVENT,
+	BASH_ASYNC_JOBS_REQUEST_EVENT,
+	jobsIndicator,
+	killedJobsDetails,
+	parseJobsUpdate,
+	watchBackgroundJobs,
+} from "./background-jobs.ts";
+
+test("jobsIndicator: empty for none, glyph+count otherwise", () => {
+	assert.equal(jobsIndicator(0), "");
+	assert.equal(jobsIndicator(1), "⏳1");
+	assert.equal(jobsIndicator(4), "⏳4");
+});
+
+test("parseJobsUpdate accepts v1 payloads and rejects anything else", () => {
+	assert.deepEqual(parseJobsUpdate({ version: 1, running: 1, jobs: [{ id: "j", title: "t" }] }), [
+		{ id: "j", title: "t" },
+	]);
+	assert.deepEqual(parseJobsUpdate({ version: 1, running: 0, jobs: [] }), []);
+	assert.equal(parseJobsUpdate({ version: 2, jobs: [] }), undefined);
+	assert.equal(parseJobsUpdate({ version: 1, jobs: [{ title: "no id" }] }), undefined);
+	assert.equal(parseJobsUpdate(null), undefined);
+});
+
+test("watchBackgroundJobs requests a snapshot at session_start and applies updates by session id", () => {
+	const handlers = new Map<string, (data: unknown) => void>();
+	const emitted: string[] = [];
+	let start: ((e: unknown, ctx: { sessionManager: { getSessionId(): string } }) => void) | undefined;
+	const applied: [string, number][] = [];
+	watchBackgroundJobs(
+		{
+			on: (_event, handler) => {
+				start = handler;
+			},
+			events: {
+				on: (channel, handler) => {
+					handlers.set(channel, handler);
+					return () => {};
+				},
+				emit: (channel) => emitted.push(channel),
+			},
+		},
+		(sessionId, jobs) => applied.push([sessionId, jobs.length]),
+	);
+	const announce = (n: number) =>
+		handlers.get(BASH_ASYNC_JOBS_EVENT)?.({ version: 1, running: n, jobs: Array.from({ length: n }, (_, i) => ({ id: `j${i}` })) });
+	announce(1);
+	assert.deepEqual(applied, [], "nothing applied before the session is known");
+	start?.({}, { sessionManager: { getSessionId: () => "s1" } });
+	assert.deepEqual(emitted, [BASH_ASYNC_JOBS_REQUEST_EVENT]);
+	announce(2);
+	announce(0);
+	handlers.get(BASH_ASYNC_JOBS_EVENT)?.({ version: 9 });
+	assert.deepEqual(applied, [
+		["s1", 0], // reset at session_start, so jobs from before a /reload can't linger unanswered
+		["s1", 2],
+		["s1", 0],
+	]);
+});
+
+test("killedJobsDetails names only killed agents that had jobs", () => {
+	const before = new Map([
+		["a", [{ id: "1", title: "npm test" }, { id: "2", title: "" }]],
+		["b", undefined],
+		["c", [{ id: "3", title: "x".repeat(60) }]],
+	]);
+	assert.deepEqual(killedJobsDetails(before, ["a", "b"]), ['stopped background jobs of a: "npm test", "2"']);
+	assert.match(killedJobsDetails(before, ["c"])[0], /x…"$/);
+	assert.deepEqual(killedJobsDetails(before, ["b"]), []);
+});
