@@ -0,0 +1,158 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+	ActivityPublisher,
+	hasActiveBackgroundAgent,
+	installActivityNotifier,
+	isBackgroundAgentActive,
+	notifyActivity,
+	subagentsActivityUpdate,
+} from "./activity.ts";
+
+type RecordState = Parameters<typeof isBackgroundAgentActive>[0];
+const rec = (state: Partial<RecordState> & Pick<RecordState, "name">): RecordState => ({
+	pending: false,
+	streaming: false,
+	compacting: false,
+	...state,
+});
+const flush = () => new Promise<void>((resolve) => setImmediate(resolve));
+
+test("background activity follows unsettled work even when an agent has been halted", () => {
+	assert.equal(isBackgroundAgentActive(rec({ name: "pending", pending: true })), true);
+	assert.equal(isBackgroundAgentActive(rec({ name: "streaming", streaming: true })), true);
+	assert.equal(isBackgroundAgentActive(rec({ name: "compacting", compacting: true })), true);
+	assert.equal(isBackgroundAgentActive(rec({ name: "main", streaming: true })), false);
+	assert.equal(isBackgroundAgentActive({ ...rec({ name: "halted" }), streaming: true, halted: true } as RecordState), true);
+});
+
+test("aggregate activity is a boolean union independent of group pause state", () => {
+	const records = [
+		rec({ name: "one", streaming: true }),
+		rec({ name: "two", compacting: true }),
+		rec({ name: "idle" }),
+	];
+	assert.equal(hasActiveBackgroundAgent(records), true);
+	assert.equal(hasActiveBackgroundAgent(records.map((r) => ({ ...r, streaming: false, compacting: false }))), false);
+});
+
+test("source snapshots keep raw activity independent from terminal-progress policy", () => {
+	assert.deepEqual(subagentsActivityUpdate(true, false), {
+		version: 1,
+		source: "fdietze-subagents",
+		active: true,
+		terminalProgress: false,
+	});
+	assert.equal(subagentsActivityUpdate(true, true).terminalProgress, true);
+	assert.equal(subagentsActivityUpdate(false, true).terminalProgress, false);
+});
+
+test("publisher reconciles live terminal-progress setting changes during continuous work", async () => {
+	let active = true;
+	let terminalProgressEnabled = true;
+	const updates: ReturnType<typeof subagentsActivityUpdate>[] = [];
+	const publisher = new ActivityPublisher({
+		readActive: () => active,
+		readTerminalProgressEnabled: async () => terminalProgressEnabled,
+		emit: (update) => updates.push(update),
+		pollMs: 60_000,
+	});
+
+	publisher.notify(true);
+	await publisher.refreshTerminalProgress();
+	await flush();
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, true));
+
+	terminalProgressEnabled = false;
+	await publisher.refreshTerminalProgress();
+	await flush();
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, false));
+
+	terminalProgressEnabled = true;
+	await publisher.refreshTerminalProgress();
+	await flush();
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, true));
+	assert.ok(updates.every((update) => update.active), "settings changes must not stop raw activity");
+
+	active = false;
+	publisher.notify();
+	await flush();
+	assert.deepEqual(updates.at(-1), subagentsActivityUpdate(false, true));
+	publisher.dispose();
+});
+
+test("publisher polling starts and stops with activity and read failures revoke OSC", async () => {
+	const originalSetInterval = globalThis.setInterval;
+	const originalClearInterval = globalThis.clearInterval;
+	let pollTick: (() => void) | undefined;
+	let starts = 0;
+	let stops = 0;
+	globalThis.setInterval = ((callback: () => void) => {
+		starts++;
+		pollTick = callback;
+		return 1;
+	}) as typeof setInterval;
+	globalThis.clearInterval = (() => { stops++; }) as typeof clearInterval;
+	let publisher: ActivityPublisher | undefined;
+	try {
+		let active = false;
+		let terminalProgressEnabled = true;
+		let rejectRead = false;
+		const updates: ReturnType<typeof subagentsActivityUpdate>[] = [];
+		publisher = new ActivityPublisher({
+			readActive: () => active,
+			readTerminalProgressEnabled: async () => {
+				if (rejectRead) throw new Error("settings unavailable");
+				return terminalProgressEnabled;
+			},
+			emit: (update) => updates.push(update),
+		});
+
+		active = true;
+		publisher.notify();
+		await publisher.refreshTerminalProgress();
+		await flush();
+		assert.equal(starts, 1);
+		assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, true));
+
+		terminalProgressEnabled = false;
+		pollTick?.();
+		await flush();
+		assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, false));
+
+		terminalProgressEnabled = true;
+		pollTick?.();
+		await flush();
+		assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, true));
+		rejectRead = true;
+		pollTick?.();
+		await flush();
+		assert.deepEqual(updates.at(-1), subagentsActivityUpdate(true, false));
+
+		active = false;
+		publisher.notify();
+		await flush();
+		assert.equal(stops, 1);
+		assert.deepEqual(updates.at(-1), subagentsActivityUpdate(false, false));
+	} finally {
+		publisher?.dispose();
+		globalThis.setInterval = originalSetInterval;
+		globalThis.clearInterval = originalClearInterval;
+	}
+});
+
+test("retained child callbacks follow the newest reload notifier", () => {
+	const calls: string[] = [];
+	const clearOld = installActivityNotifier(() => calls.push("old"));
+	const retainedChildCallback = notifyActivity;
+	retainedChildCallback();
+
+	const clearNew = installActivityNotifier(() => calls.push("new"));
+	retainedChildCallback();
+	clearOld();
+	retainedChildCallback();
+	clearNew();
+	retainedChildCallback();
+
+	assert.deepEqual(calls, ["old", "new", "new"]);
+});
